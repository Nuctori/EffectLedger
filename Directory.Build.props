<Project>

  <!-- A4-13（生产审计批2）：全仓共享 NuGet 打包元数据——来源可溯（RepositoryUrl）、nuget.org 页面带 README。
       PackageId/Version/Description 等包特有元数据仍留在各 csproj；此处只放跨包一致的来源性字段。 -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Nuctori/Cosmos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <!-- R2B-03（二轮审计）：nuget.org 页面带 README（此前仅注释声称，pack 一直报"缺少自述文件"）。 -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- R3 审计：全部测试项目统一串行执行（MaxCpuCount=1），根除多 testhost 并发 OOM 假红；非测试项目不消费此属性。 -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
    <!-- 【P4-E1】semver 单一真源：全包族（L1/Analyzer/Generator/Runtime/Tool）统一版本。
         发布流程：按 semver 决策改这一行（破坏性+.1、功能+.1、修复+.0.1）→ 走 PUBLISH-CHECKLIST。
         根除 NuGet 同 id+version 本地重打包缓存陷阱：版本一旦变更即新缓存键（README ⓪ 的运维注记）。 -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 各 packable csproj 的包内 README（路径相对各 csproj：src/X 或 tests/X 或 samples/X 均为 ..\..\README.md）。 -->
    <None Include="../../README.md" Pack="true" PackagePath="" Condition="Exists('../../README.md')" /><!-- R3-CG-03：正斜杠——反斜杠在 Linux MSBuild 的 Exists() 按字面文件名解析恒 false ⇒ NU5039 -->
  </ItemGroup>

</Project>

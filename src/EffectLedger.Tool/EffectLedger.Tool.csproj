<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>effectledger</ToolCommandName>
    <PackageId>EffectLedger.Tool</PackageId>
    <Authors>Nuctori</Authors>
    <Description>effectledger audit — EffectScript JSON → Audit(Violation) 一键门（AI 回修闭环）</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EffectLedger\EffectLedger.csproj" />
  </ItemGroup>
</Project>

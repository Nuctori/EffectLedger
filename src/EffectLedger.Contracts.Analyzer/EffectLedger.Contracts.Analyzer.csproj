<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 复用现有分析器宿主策略：net9.0 + Roslyn 4.12，与 SDK 自带 Roslyn 5 同代（见 src/EffectLedger.Analyzer）。
         自包含：直接引用 Roslyn，不引用户工程程序集。 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS1041;RS2008;RS2007</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <PackageId>EffectLedger.Contracts.Analyzer</PackageId>
    <Authors>Nuctori</Authors>
    <Company>Nuctori</Company>
    <Description>可选类型行为约束编译期分析器（实验）：检查 IConstrained&lt;ImmutableValue&gt; / IConstrained&lt;DeterministicComputation&gt; 的实现是否满足角色。零 Godot 依赖。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>roslyn-analyzer;immutability;determinism;contracts</PackageTags>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

</Project>

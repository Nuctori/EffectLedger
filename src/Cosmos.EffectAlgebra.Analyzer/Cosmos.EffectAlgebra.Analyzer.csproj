<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 分析器以 net9.0 为目标：与 SDK 自带 Roslyn 5.0.0.0 同代，且共享运行时（System.Runtime 9.0 / System.Collections.Immutable in-box），
         根除 CS8032（分析器在编译器隔离 ALC 中因 Roslyn/运行时版本错位而无法实例化）。
         RS1041（建议 netstandard2.0）为 advisory，此处显式 NoWarn：net9.0 分析器在 .NET 10 SDK 编译器中可正常加载。 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS1041;RS2008;RS2007</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NuGet 打包元数据（P0-2：生产可分发）。分析器 DLL 经 Roslyn 目标自动落入 analyzers/dotnet/cs/。 -->
    <IsPackable>true</IsPackable>
    <PackageId>Cosmos.EffectAlgebra.Analyzer</PackageId>
    <Authors>Nuctori</Authors>
    <Company>Cosmos</Company>
    <Description>资源效应代价代数 L3 编译期分析器：资源泄漏 (EAA0901) / 量纲隔离 (EAA0303) / 兼容冲突 (EAA0304) / 逃逸参数校验 (EAA0801/0802) 早期根因诊断（§3.3.1 / §3.1.4b / §3.2.3 / §8.3）。零 Godot 依赖。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>roslyn-analyzer;effect-algebra;leak;godot</PackageTags>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- L3 是 Roslyn DiagnosticAnalyzer；仅依赖 Roslyn + L1 纯代数（零 Godot）。
         CS8032 根因：编译器隔离 ALC 不会加载分析器的 ProjectReference 程序集（L1），导致实例化失败。
         修复：将 L1 所需源文件直接 Compile 进分析器（单一事实来源、零程序集依赖），分析器在隔离 ALC 中自包含。
         Roslyn 不引 NuGet 包 —— 编译器自带 5.0.0.0，避免 4.12.0≠5.0.0.0 错位。
         不引用 Godot.NET.Sdk（本机未装，会还原失败）。
         L1 源以「命名空间改写副本」(Cosmos.EffectAlgebra.Analyzer.Shared) 编入，避免与消费方同时引用的 L1 本体 (Cosmos.EffectAlgebra)
         发生 ResourceId/Signature 同名冲突 (CS0433)。L1 仍是唯一事实来源（PrepareAnalyzerSharedSources 在构建期从 L1 派生）。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <ShareSource Include="..\Cosmos.EffectAlgebra\Objects.cs" />
    <ShareSource Include="..\Cosmos.EffectAlgebra\ApiMapping.cs" />
    <ShareSource Include="..\Cosmos.EffectAlgebra\Algebra.cs" />
    <ShareSource Include="..\Cosmos.EffectAlgebra\Numeric.cs" />
    <ShareSource Include="..\Cosmos.EffectAlgebra\SignedNet.cs" />
    <!-- QED-C1b：cosmos.effect.json 白名单扩展真接线——分析器经 AdditionalFiles 消费该配置，
         严格解析（LoadExtraFromJson）+ MergedWith 合并视图须与分析器同程序集（隔离 ALC 自包含）。
         System.Text.Json 为 net9.0 BCL 内箱（宿主前提不变：仅 dotnet build 的 Roslyn 宿主，README R2B-02）。 -->
    <ShareSource Include="..\Cosmos.EffectAlgebra\CosmosEffectConfig.cs" />
  </ItemGroup>

  <!-- 构建期从 L1 派生命名空间改写副本：namespace Cosmos.EffectAlgebra[.X] -> Cosmos.EffectAlgebra.Analyzer.Shared[.X]，
       写入 IntermediateOutputPath\AnalyzerShared\，作为分析器自包含编译单元（不触碰 L1 本体）。 -->
  <!-- 【QED-C1b 修复】WriteLinesToFile 管道走 MSBuild 字符串通道，Linux 上对非 ASCII（⊤）有损——
       ⊤ 在注释里 historically 无害，进字符串字面量（CosmosEffectConfig.ParseNat 的 "⊤" 别名）即语法错误（CI 连红根因）。
       改为 Copy 字节级副本 + 条件命名空间（#if ANALYZER_SHARED），全平台无损、确定性。 -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);ANALYZER_SHARED</DefineConstants>
  </PropertyGroup>
  <Target Name="PrepareAnalyzerSharedSources" BeforeTargets="CoreCompile" Inputs="@(ShareSource)" Outputs="@(ShareSource->'$(IntermediateOutputPath)AnalyzerShared\%(Filename).cs')">
    <MakeDir Directories="$(IntermediateOutputPath)AnalyzerShared" />
    <Copy SourceFiles="%(ShareSource.FullPath)" DestinationFiles="$(IntermediateOutputPath)AnalyzerShared\%(ShareSource.Filename).cs" />
    <ItemGroup>
      <Compile Remove="@(ShareSource)" />
      <Compile Include="$(IntermediateOutputPath)AnalyzerShared\%(ShareSource.Filename).cs" />
    </ItemGroup>
  </Target>

  <!-- 分析器 DLL 打包进 analyzers/dotnet/cs/（消费方编译期自动加载）；IncludeBuildOutput=false 故需显式 None Pack。 -->
  <ItemGroup>
    <None Include="bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>

</Project>

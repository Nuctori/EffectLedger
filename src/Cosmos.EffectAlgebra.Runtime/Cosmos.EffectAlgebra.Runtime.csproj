<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 多目标：net8.0(Godot 4.x) + net9.0(Roslyn) + net10.0(测试/游戏)，零 Godot 依赖经 IHost -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>true</IsPackable>
    <PackageId>Cosmos.EffectAlgebra.Runtime</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nuctori</Authors>
    <Company>Cosmos</Company>
    <Description>资源效应代价代数 Runtime：Fiber 状态机/依赖图/逆回放/宿主抽象，零 Godot 依赖（经 IHost）。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>effect-algebra;runtime;godot;fiber</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cosmos.EffectAlgebra\Cosmos.EffectAlgebra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- R2A-10：DependencyGraph.Remove 收为 internal，测试程序集经此可见（账本同步守卫）。 -->
    <InternalsVisibleTo Include="Cosmos.EffectAlgebra.Runtime.Tests" />
  </ItemGroup>
</Project>

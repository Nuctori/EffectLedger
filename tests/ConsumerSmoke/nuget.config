<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 打包消费烟测：EffectLedger* 五包只来自本地 pack 产物（ci.yml / ci.sh / ci.ps1 打到仓库
         artifacts/feed，与 nuget.org 上尚不存在的包零混淆）；nuget.org 仅供 .NET 目标框架引用包
         （Microsoft.NETCore.App.Ref 等）按 SDK 常规渠道下载。 -->
    <clear />
    <add key="local-feed" value="../../artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
